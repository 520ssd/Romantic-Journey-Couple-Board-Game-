{
  "name": "romantic-journey",
  "main": "src/index.ts",  // 或者 "worker/index.ts"
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",  // 前端构建产物
    "binding": "ASSETS"
  },
  "vars": {
    // 你的 AI API Keys
    "DEEPSEEK_API_KEY": "your-key-here",
    "GLM_API_KEY": "your-key-here"
  }
}